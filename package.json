{
  "name": "@revisium/examples",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate": "npm run validate:examples && npm run test && npm run lint && npm run lint:sonar",
    "validate:examples": "bash scripts/validate-examples.sh",
    "lint": "eslint . --ignore-pattern 'apps/*/project/**'",
    "lint:sonar": "mkdir -p reports && eslint . --ignore-pattern 'apps/*/project/**' --format json --output-file reports/eslint-report.json",
    "test": "node --test tests/*.test.mjs",
    "bootstrap:nestjs": "node apps/nestjs-dictionary-service/scripts/bootstrap.mjs",
    "bootstrap:nextjs": "node apps/nextjs-remote-config/scripts/bootstrap.mjs",
    "bootstrap:react": "node apps/react-feature-flags/scripts/bootstrap.mjs",
    "bootstrap:mcp-kb": "node apps/mcp-knowledge-base/scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@revisium/client": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0"
  }
}
